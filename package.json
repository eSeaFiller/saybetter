{
  "name": "saybetter-a-lingoisland",
  "version": "0.8.3",
  "description": "Saybetter-A lingoisland — 极简 macOS 菜单栏表达与学习助手",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:native",
    "start": "electron .",
    "test": "node --test scripts/app.test.js",
    "ui:smoke": "electron scripts/ui-smoke.js",
    "build:native": "mkdir -p native/bin && swiftc native/LingoIslandStatus.swift -o native/bin/LingoIslandStatus -framework Cocoa && codesign --force --sign - native/bin/LingoIslandStatus",
    "predist": "npm run build:native",
    "dist": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "dmg-license": "^1.0.11",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lingoisland.app",
    "productName": "Saybetter-A lingoisland",
    "files": [
      "main.js",
      "preload.js",
      "preload-pill.js",
      "providers.js",
      "updater.js",
      "renderer/**",
      "LICENSE",
      "traySayBetterTemplate.png",
      "traySayBetterTemplate@2x.png",
      "traySayBetterBusyTemplate.png",
      "traySayBetterBusyTemplate@2x.png",
      "trayLTemplate.png",
      "trayLTemplate@2x.png"
    ],
    "extraResources": [
      {
        "from": "native/bin/LingoIslandStatus",
        "to": "native/LingoIslandStatus"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "Assets/LingoIsland.icns",
      "minimumSystemVersion": "13.0.0",
      "artifactName": "Saybetter-A-lingoisland-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.lingoisland.app.commands",
            "CFBundleURLSchemes": [
              "lingoisland"
            ]
          }
        ]
      },
      "target": "dmg"
    }
  }
}
