{
  "name": "saybetter",
  "version": "0.5.0",
  "description": "SayBetter — 菜单栏常驻的语法与表达检查小工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "dmg-license": "^1.0.11",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.saybetter",
    "productName": "SayBetter",
    "files": [
      "main.js",
      "preload.js",
      "preload-pill.js",
      "providers.js",
      "updater.js",
      "renderer/**",
      "traySayBetterTemplate.png",
      "traySayBetterTemplate@2x.png",
      "traySayBetterBusyTemplate.png",
      "traySayBetterBusyTemplate@2x.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "Assets/AppIcon.png",
      "minimumSystemVersion": "13.0.0",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": "dmg"
    }
  }
}
